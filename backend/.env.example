# Copy this file to ".env" in the same folder and fill in your values.
# ".env" is ignored by git, so your password stays on your computer.
# Run the backend from this folder (./mvnw spring-boot:run) so the file is found.

DB_PASSWORD=choose-a-password

# Optional. The defaults are shown:
# DB_URL=jdbc:postgresql://localhost:5432/meetmind_db
# DB_USERNAME=meetmind_user
# AI_SERVICE_URL=http://127.0.0.1:8000
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
