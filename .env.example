# Copy this file to .env and fill in both values.

# The password of the database.
DB_PASSWORD=change-me

# Signs the login tokens: at least 32 random characters. Make one with:
#     openssl rand -base64 32
# If you leave it empty, everybody has to log in again whenever the backend restarts.
JWT_SECRET=

# Optional: how many wrong passwords lock an email, and for how many minutes.
# MAX_LOGIN_FAILURES=5
# LOGIN_LOCK_MINUTES=15
